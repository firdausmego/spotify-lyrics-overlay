{
  "manifest_version": 3,
  "name": "Spotify Lyrics Overlay",
  "version": "1.0.0",
  "description": "Synced lyrics for the Spotify Web Player, floating on top of your desktop.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Spotify Lyrics Overlay",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://lrclib.net/*"],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
